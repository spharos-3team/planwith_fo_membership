# Local / IntelliJ. Docker overrides via env/membership.env on the server.
# Infra MySQL host port is 3307.

DB_URL=jdbc:mysql://127.0.0.1:3307/membership_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=membership_user
DB_PASSWORD=membership_pass
JPA_DDL_AUTO=update
EUREKA_CLIENT_ENABLED=false
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/

REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MEMBERSHIP_KAFKA_CONSUMER_ENABLED=false
MEMBERSHIP_OUTBOX_ENABLED=false
